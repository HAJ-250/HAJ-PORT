# Site URL used for canonical URLs, sitemap.xml and OG tags (no trailing slash)
VITE_SITE_URL=https://your-project.vercel.app

# Contact form email delivery (Resend) — OPTIONAL
# Without these, the form automatically falls back to a
# pre-addressed email in the visitor's own mail app (mailto:),
# so visitor comments still reach you with zero configuration.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hirwaaime41@gmail.com
CONTACT_FROM_EMAIL=
